<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:client.ViewModels"
             x:Class="client.Views.DashBoardView">

    <ContentPage.BindingContext>
        <viewmodels:DashBoardViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout Padding="10">
        <!-- 상단 토글 + 체크박스 -->
        <HorizontalStackLayout Spacing="20" VerticalOptions="Start">
            <Label Text="모드:" VerticalOptions="Center" />
            <Switch IsToggled="{Binding IsAutoMode}" />
            <Label Text="자동/수동" VerticalOptions="Center" />
            <CheckBox IsChecked="{Binding IsAutoRevertEnabled}" />
            <Label Text="체크 ON=고정, OFF=자동전환" VerticalOptions="Center" />
        </HorizontalStackLayout>

        <!-- 상태 표시 -->
        <Label Text="{Binding StatusText}" FontSize="18" TextColor="Black" />

        <!-- 기능 버튼들 -->
        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
            <Button Grid.Row="0" Grid.Column="0" Text="히터"
                    Command="{Binding Func01Command}"
                    BackgroundColor="{Binding Func01Color}"
                    IsEnabled="{Binding CanManualControl}" />

            <Button Grid.Row="0" Grid.Column="1" Text="팬"
                    Command="{Binding Func02Command}"
                    BackgroundColor="{Binding Func02Color}"
                    IsEnabled="{Binding CanManualControl}" />

            <Button Grid.Row="1" Grid.Column="0" Text="여과"
                    Command="{Binding Func03Command}"
                    BackgroundColor="{Binding Func03Color}"
                    IsEnabled="{Binding CanManualControl}" />

            <Button Grid.Row="1" Grid.Column="1" Text="펌프1"
                    Command="{Binding Func04Command}"
                    BackgroundColor="{Binding Func04Color}"
                    IsEnabled="{Binding CanManualControl}" />

            <Button Grid.Row="2" Grid.Column="0" Text="펌프2"
                    Command="{Binding Func05Command}"
                    BackgroundColor="{Binding Func05Color}"
                    IsEnabled="{Binding CanManualControl}" />

            <Button Grid.Row="2" Grid.Column="1" Text="먹이"
                    Command="{Binding Func06Command}"
                    BackgroundColor="{Binding Func06Color}"
                    IsEnabled="{Binding CanManualControl}" />
        </Grid>

        <!-- LED 제어 (라디오 + 슬라이더) -->
        <Label Text="LED 제어" FontSize="20" Margin="0,20,0,0" />
        <HorizontalStackLayout>
            <RadioButton Content="W" GroupName="LedColor" CheckedChanged="OnLedRadioChecked" />
            <RadioButton Content="R" GroupName="LedColor" CheckedChanged="OnLedRadioChecked" />
            <RadioButton Content="G" GroupName="LedColor" CheckedChanged="OnLedRadioChecked" />
            <RadioButton Content="B" GroupName="LedColor" CheckedChanged="OnLedRadioChecked" />
        </HorizontalStackLayout>

        <Slider Minimum="85" Maximum="255" Value="{Binding Intensity}" />
        <Label Text="{Binding IntensityLabel}" />

        <!-- 상세/로그/설정 버튼 -->
        <Button Text="설정" Command="{Binding OpenSettingsCommand}" />
        <Button Text="로그 보기" Command="{Binding Func10Command}" />
    </VerticalStackLayout>
</ContentPage>
